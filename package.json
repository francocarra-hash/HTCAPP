{
  "name": "htc-platform",
  "version": "0.1.0",
  "private": true,
  "description": "HTC (Hit The Climax) Platform — canonical-driven physical decision system. MVP: Assessment → Classification → Decision → Pathway → Reasoning Card → Client Report.",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "start": "node dist/app.js",
    "dev": "ts-node src/app.ts",
    "migrate": "ts-node src/db/migrate.ts",
    "demo:move": "ts-node src/demo/case_move.ts",
    "demo:build": "ts-node src/demo/case_build.ts"
  },
  "dependencies": {
    "express": "^4.19.2",
    "js-yaml": "^4.1.0",
    "pg": "^8.22.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.14.9",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3"
  }
}
