# Variables de entorno de HTC Platform v3.0.
# Copiá este archivo a .env para correr local, o cargá estos valores en Render.

# Postgres (Neon). Usá el connection string POOLED (host con -pooler) y ?sslmode=require.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Password del coach para entrar a la app (se lo pasás a Nico). Obligatoria en cualquier deploy hosteado.
HTC_AUTH_PASSWORD="cambiá-esto"

# Secreto para firmar los tokens de sesión. En Render se genera solo; local poné cualquier string largo.
HTC_AUTH_SECRET="un-secreto-largo-aleatorio"

# Puerto (Render lo setea solo; local por defecto 3000).
# PORT=3000
